  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Link, useNavigate, useLocation } from \'react-router-dom\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { Shield, Coins, LogOut, User, Lock } from \'lucide-react\';\n\nexport const Navbar: React.FC = () => {\n  const { user, token, isAdmin, adminUser, logout, adminLogout } = useAuth();\n  const navigate = useNavigate();\n  const location = useLocation();\n\n  const handleLogout = () => {\n    logout();\n    navigate(\'/login\');\n  };\n\n  const handleAdminLogout = () => {\n    adminLogout();\n    navigate(\'/admin/login\');\n  };\n\n  const isAdminRoute = location.pathname.startsWith(\'/admin\');\n\n  return (\n    <header className=\"bg-[#1E293B]/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50 px-6 py-4 flex items-center justify-between gap-8\">\n      {/* Zone 1: Brand */}\n      <Link to={isAdminRoute ? \'/admin/dashboard\' : \'/user-profile\'} className=\"flex items-center gap-2.5 text-white whitespace-nowrap shrink-0\">\n        <div className=\"w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-yellow-600 flex items-center justify-center font-extrabold text-slate-950 shadow-md\">\n          VE\n        </div>\n        <div>\n          <span className=\"text-lg font-bold tracking-tight text-white block\">VELoop Rewards</span>\n          <span className=\"text-[10px] text-amber-400 font-mono block -mt-1\">{isAdminRoute ? \'Admin Console\' : \'Member Portal\'}</span>\n        </div>\n      </Link>\n\n      {/* Zone 2: Navigation Links */}\n      {!isAdminRoute && token && (\n        <nav className=\"hidden md:flex items-center gap-6 text-sm font-medium text-slate-300\">\n          <Link to=\"/user-profile\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Dashboard</Link>\n          <a href=\"#rewards\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Rewards</a>\n          <a href=\"#withdrawals\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Withdrawals</a>\n          <a href=\"#referrals\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Referrals</a>\n        </nav>\n      )}\n\n      {isAdminRoute && isAdmin && (\n        <nav className=\"hidden md:flex items-center gap-6 text-sm font-medium text-slate-300\">\n          <Link to=\"/admin/dashboard\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Overview</Link>\n          <Link to=\"/admin/dashboard\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Users</Link>\n          <Link to=\"/admin/dashboard\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Withdrawals</Link>\n          <Link to=\"/admin/dashboard\" className=\"hover:text-white transition-colors whitespace-nowrap shrink-0\">Audit Logs</Link>\n        </nav>\n      )}\n\n      {/* Zone 3: Primary Action / User Profile */}\n      <div className=\"flex items-center gap-3 shrink-0\">\n        {!isAdminRoute ? (\n          token && user ? (\n            <div className=\"flex items-center gap-3\">\n              <div className=\"hidden sm:block text-right\">\n                <span className=\"text-xs font-semibold text-white block\">{user.username}</span>\n                <span className=\"text-[10px] text-slate-400 font-mono\">Code: {user.referralCode}</span>\n              </div>\n              <button\n                onClick={handleLogout}\n                className=\"px-3.5 py-2 text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap\"\n              >\n                <LogOut className=\"w-3.5 h-3.5\" /> Logout\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex items-center gap-2\">\n              <Link\n                to=\"/login\"\n                className=\"px-4 py-2 text-xs font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-lg transition-colors whitespace-nowrap\"\n              >\n                Sign In\n              </Link>\n              <Link\n                to=\"/admin/login\"\n                className=\"px-3 py-2 text-xs font-medium text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition-colors flex items-center gap-1 whitespace-nowrap\"\n              >\n                <Lock className=\"w-3 h-3\" /> Admin\n              </Link>\n            </div>\n          )\n        ) : (\n          isAdmin && adminUser ? (\n            <div className=\"flex items-center gap-3\">\n              <div className=\"hidden sm:block text-right\">\n                <span className=\"text-xs font-semibold text-white block\">{adminUser.username}</span>\n                <span className=\"text-[10px] text-amber-400 font-mono\">Role: {adminUser.role}</span>\n              </div>\n              <button\n                onClick={handleAdminLogout}\n                className=\"px-3.5 py-2 text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap\"\n              >\n                <LogOut className=\"w-3.5 h-3.5\" /> Admin Logout\n              </button>\n            </div>\n          ) : (\n            <Link\n              to=\"/admin/login\"\n              className=\"px-4 py-2 text-xs font-medium text-white bg-amber-600 hover:bg-amber-500 rounded-lg transition-colors whitespace-nowrap\"\n            >\n              Admin Sign In\n            </Link>\n          )\n        )}\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }
