      thinking_signature: "\022\371\v\n\366\v\001i\024}\023\310\212\205\365\245\325i\003\277\203R\035\023\267\030\246\245\033\225\351\254\240\032m1n\231\375\275\346*\363\221\274q\211\254\362D\vE\177\rq\037\006\256@\356E\311Z\331\223\nN\262#\202\262H\306\035\032\264\333\234\277*\a{\336\266\310\016M\274\263/c\311\364R\033Y}\260\341\304\003\344\307\002\f\311c\254\027Y\177\205w\247\024dK\003r\341qn\270\366}+\330n\r9\304[U\213\317\2710j\033\220\333\337N\322\277#\346\035f\214mJe\240\324y\206\3106\332\356\307\037\223\325\205\370\376\a\217\306\v\230\t\276n(\241|\372!\277z\226\250\362w\330\204{=\177 !\301\362\324\340\333J\200\030vbWQ~\307\207\373\377|\364F>v\247S*gv@i\035\351\027\320\235\203\337\224\363\331\223\322\354\221\005\b\302+\230\213\317S\321\331X.B~gtI\377\265\327\f\342Q0\002\363\017z\344\330\265A\034\004\223ug\352Po\022[|\324\350\357\241\304t\360}\f\316\346X\263\263L\3772\024\360\017\304t\303\371!$\3567j\341\261A\253\270\n\017\353\237\311\307c\016y\004\277\325\325\345w\210\f&T,\234\362\030\255\020\\:\212\f\240c\a\003UB\307f\352\343\021V\347\266\017\312A$\361\177\232\032W\266\234\326_2\a\002\263\f\3439w8\365y\345h\277_\026\372\361{\257\236h\334\370\022P\237\345\221q8#\275EU\207\335\003\bA\212\220e\321\332\343i\3736W\276X\201\213P\377H>\331\221\303\354\312m\335R\372\r@\355/#<R\352\326\366\004\023!\027\243D\"\2433\305\343\236\003u5\343!\3426\253\242,m\356\353(\363%\326{\3264\320\255=\330\311\f\373%\356\366ge-\264\253\245\212\203\301\375\215\272\353\256\267\264\n\v\373\305\331\274\222\276]Oj\240\030\235\326M\031T\273\366d\277i\"}\346x\020\373\263\317\344\206\307\215\a\241\231T\241\305x\f\217I\330+X;\221\313\220\316u\264-\274\351h<\250\315\315\227>\375\352\371mL\2478T\340\322\257O\vVc\212\026\266\017g_\325c.\223\364\223\a\337\256@\f\244\231`\344d\213i:\243j\000\307\211\3258\212\243\b\223\263\224r\'\313\345\332\342;\333\330\212\331\257tO:\334\300\262\361\025E<\v\311\233\0239\273\266e\nN\333*\345\260\240]\350\325\t\237\317\023\253|\245\fO\037\3777A\360\311pZ\341\262y\336\