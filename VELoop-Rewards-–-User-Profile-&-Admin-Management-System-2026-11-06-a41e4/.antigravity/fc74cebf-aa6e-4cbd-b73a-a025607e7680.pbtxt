  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Award, CheckCircle2, Copy } from \'lucide-react\';\nimport { copyToClipboard, formatNumber } from \'../../utils/helpers\';\nimport styles from \'./ProfileHero.module.css\';\n\ninterface ProfileHeroProps {\n  user: any;\n  levelData: any;\n  onCopyToast: (msg: string) => void;\n}\n\nexport const ProfileHero: React.FC<ProfileHeroProps> = ({ user, levelData, onCopyToast }) => {\n  const initials = user?.username\n    ? user.username.split(\' \').map((n: string) => n[0]).join(\'\').toUpperCase()\n    : \'AV\';\n\n  return (\n    <div className={styles.heroCard}>\n      <div className=\"row align-items-center g-4\">\n        <div className=\"col-lg-8 d-flex align-items-center gap-4\">\n          <div className={styles.avatar}>\n            {initials}\n          </div>\n\n          <div>\n            <div className=\"d-flex align-items-center gap-2 mb-2\">\n              <span className=\"badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 d-flex align-items-center gap-1\">\n                <CheckCircle2 size={14} /> {user?.status || \'Active\'}\n              </span>\n              <span className=\"text-secondary font-monospace small\">ID: {user?.id?.substring(0, 8)}...</span>\n              <button\n                onClick={() => {\n                  copyToClipboard(user?.id || \'\');\n                  onCopyToast(\'User ID copied to clipboard!\');\n                }}\n                className=\"btn btn-link text-secondary p-0 text-decoration-none\"\n                title=\"Copy User ID\"\n              >\n                <Copy size={14} />\n              </button>\n            </div>\n\n            <h1 className=\"h3 fw-bold text-white mb-1\">\n              Welcome back, {user?.username || \'Explorer\'}!\n            </h1>\n            <p className=\"text-muted small mb-0\">\n              {user?.email} \302\267 Member since {new Date(user?.createdAt || Date.now()).toLocaleDateString(\'en-US\', { month: \'short\', year: \'numeric\' })}\n            </p>\n          </div>\n        </div>\n\n        <div className=\"col-lg-4\">\n          <div className={styles.levelBox}>\n            <div className=\"d-flex align-items-center justify-between mb-2\">\n              <span className=\"small text-warning fw-semibold d-flex align-items-center gap-1\">\n                <Award size={16} /> Level 0{levelData?.currentLevel || 1} \342\200\223 {levelData?.levelName || \'Novice\'}\n              </span>\n              <span className=\"small font-monospace text-muted\">\n                {formatNumber(levelData?.currentXp)} / {formatNumber(levelData?.requiredXp)} XP\n              </span>\n            </div>\n\n            <div className=\"progress bg-secondary bg-opacity-25 mb-2\" style={{ height: \'8px\' }}>\n              <div\n                className=\"progress-bar bg-warning\"\n                role=\"progressbar\"\n                style={{ width: `${levelData?.progressPercent || 25}%` }}\n              ></div>\n            </div>\n\n            <div className=\"text-end small font-monospace text-muted\">\n              {formatNumber(levelData?.remainingXp)} XP to next level\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ProfileHero/ProfileHero.tsx"
        }
        overwrite: true
      }
    }
