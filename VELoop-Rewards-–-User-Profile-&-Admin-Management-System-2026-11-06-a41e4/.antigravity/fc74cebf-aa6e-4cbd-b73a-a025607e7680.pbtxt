  view_file {
    absolute_path_uri: "file:///server/routes/api.ts"
    end_line: 99
    content: "import { Router } from \'express\';\nimport bcrypt from \'bcryptjs\';\nimport jwt from \'jsonwebtoken\';\nimport mongoose from \'mongoose\';\nimport {\n  UserModel,\n  WalletModel,\n  WalletTransactionModel,\n  LevelConfigModel,\n  AchievementModel,\n  UserAchievementModel,\n  ReferralModel,\n  WithdrawalModel,\n  ActivityLogModel,\n  AdminUserModel,\n  AdminAuditLogModel\n} from \'../models/schemas.ts\';\nimport { verifyUserToken, verifyAdminToken, AuthRequest } from \'../middleware/auth.ts\';\nimport { fallbackStore } from \'../data/fallbackStore.ts\';\n\nconst router = Router();\nconst JWT_SECRET = process.env.JWT_SECRET || \'veloop_secure_jwt_secret_key_2026\';\n\nconst isDbReady = () => mongoose.connection.readyState === 1;\n\n// ==================== AUTH ROUTES ====================\n\nrouter.post(\'/auth/register\', async (req, res) => {\n  try {\n    const { username, email, password, referralCode } = req.body;\n    if (!username || !email || !password) {\n      return res.status(400).json({ error: \'Please provide username, email, and password.\' });\n    }\n\n    if (!isDbReady()) {\n      const existing = fallbackStore.users.find(u => u.email === email);\n      if (existing) return res.status(400).json({ error: \'Email already registered.\' });\n\n      const passwordHash = await bcrypt.hash(password, 10);\n      const userId = \'user_\' + Date.now();\n      const userReferralCode = username.substring(0, 4).toUpperCase() + Math.floor(1000 + Math.random() * 9000);\n\n      const newUser = {\n        _id: userId,\n        username,\n        email,\n        passwordHash,\n        referralCode: userReferralCode,\n        status: \'active\',\n        emailVerified: true,\n        createdAt: new Date()\n      };\n      fallbackStore.users.push(newUser);\n\n      fallbackStore.wallets.push({\n        _id: \'wallet_\' + userId,\n        userId,\n        veBalance: 100,\n        sveBalance: 20,\n        gemsBalance: 5,\n        tokensBalance: 50,\n        xpBalance: 250,\n        currentLevel: 1\n      });\n\n      const token = jwt.sign({ id: userId, email }, JWT_SECRET, { expiresIn: \'7d\' });\n      return res.status(201).json({\n        message: \'Registration successful\',\n        token,\n        user: { id: userId, username, email, referralCode: userReferralCode, status: \'active\' }\n      });\n    }\n\n    const existingUser = await UserModel.findOne({ email });\n    if (existingUser) {\n      return res.status(400).json({ error: \'Email already registered.\' });\n    }\n\n    const passwordHash = await bcrypt.hash(password, 10);\n    const userReferralCode = username.substring(0, 4).toUpperCase() + Math.floor(1000 + Math.random() * 9000);\n\n    const newUser = await UserModel.create({\n      username,\n      email,\n      passwordHash,\n      referralCode: userReferralCode,\n      status: \'active\'\n    });\n\n    await WalletModel.create({\n      userId: newUser._id,\n      veBalance: 100,\n      sveBalance: 20,\n      gemsBalance: 5,\n      tokensBalance: 50,\n      xpBalance: 250,\n      currentLevel: 1\n    });\n\n    const token = jwt.sign({ id: newUser._id, email: newUser.email }, JWT_SECRET, { expiresIn: \'7d\' });"
    num_lines: 671
    num_bytes: 23950
    line_range_bytes: 3053
  }
}
