      thinking_signature: "\022\376\021\n\373\021\001i\024}\023\327\246\233#\205\260\302\264\377\302Yt\360C\321\332\241\003\020\263\203\323R7xP\214\244`m\231IK\006\202\254Q\t\r\223\003\202}\320\023\267\244Z\243\030\367\252\371K\224i\3529xk\254\246\3215\n{\313\306\bU\265C>\246\267\202^K\362\334\345\'`\263\304\241\026/\3531\037X\330\346\207\312\023\22043+\r\033\221\253\212\347[3Q\261\365^\270ZT\0057\343Z\363\223\332\231\257\214:\2450\366\\\301Nz\267\2533\340\256\030\"\316\3726\275\266\020ns\311\361\037\031\240\022\226\242Oex\252\306)\352B\256\316\364\316\034eJ^[|a\270\212\343<Bz\366\307\225\321!\\\371gY\\{(S\037v\362\343\363\357:+NL#F\225\202Q\006r\256P\303/\363S\357\222\261qF\276n6\313\256\322\004\217[\266w\247\240h[\265w\'\366\r\365!hn<M^\375\230\253\3648\331\235\271\237\333\221\237m\000\214P\n\363g\177\365\264\a\'H\347\347\274q\227\a\f\0240\006\316\245\377l`\334e\371\026\037\337$\304\354\300\vb<\304\347\246\246w\201\226bic)\000\356\264c\342\006\215Z\214\313K\030\334y\341\332\n\362\262\221\206=t\227\211\214\006x\242\227\350&1\355(\346\236u\3542\200\024\342j\347\354d\030\246\222\376(\272\312\027\243K\223\2175Xa\303\326DM)\"W \025\274\306\305f\366\375T\"\365\204G\343\341\222\273\032\016[A\271\225Qn\201\364\243\203-;R\230\374A1)\246\377\200rSk\330\240\2774\222L\031&%\326\344Y\031[\024\027\027a\333i\202\270\310\202\033&\327\202~\301\357\311~\277\2361P\302v\255\211\304m\036\034#\\\023\372\203\275\214\270\270\272\260mIWS//4\376\336\302\253\254&J\211N\342e\365Y6\303\002\356I%\265:!zj<\232\335>\374;\312K\001\270dp\362ji\255\350q0W\002!\343\005;\006\023w\006\255\253Gj\361j\363\340\277\020\3622\203\316\200\343\226W\326`\020\277P\317\v\3435\247~\322X\366`3C%\345\001\035-0\204\272e\234\213\000\024@\003\264\266~\375\224\026\003\326\374Z\255\\\214\020\034\264\034\342$\203\375!3\246H\354p\305\313\322cp\371\351\026\230\275\201\005\335\230\366\215\330N\226\353\342\215\357\235&\0324\001\275\037\371\233\316Uk\220-\336\006\253\264uLW\031\332\207P\225\002\332\237q!`m\257\224,a\326u\323\