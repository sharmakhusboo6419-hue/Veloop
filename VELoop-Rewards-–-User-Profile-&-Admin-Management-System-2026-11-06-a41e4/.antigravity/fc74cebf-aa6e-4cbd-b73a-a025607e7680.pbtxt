      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { ArrowUpRight, Clock, CheckCircle2, XCircle } from \'lucide-react\';\\nimport { formatNumber } from \'../../utils/helpers\';\\n\\ninterface WithdrawalOverviewProps {\\n  summary: any;\\n  onOpenWithdrawal: () => void;\\n}\\n\\nexport const WithdrawalOverview: React.FC<WithdrawalOverviewProps> = ({ summary, onOpenWithdrawal }) => {\\n  return (\\n    <div className=\\\"bg-[#1E293B] border border-slate-800 rounded-2xl p-6 shadow-md\\\">\\n      <div className=\\\"flex items-center justify-between mb-4\\\">\\n        <h2 className=\\\"text-xl font-bold text-white tracking-tight flex items-center gap-2\\\">\\n          <ArrowUpRight className=\\\"w-5 h-5 text-blue-400\\\" /> Withdrawal Overview\\n        </h2>\\n        <button\\n          onClick={onOpenWithdrawal}\\n          className=\\\"px-3.5 py-1.5 text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white rounded-lg transition-colors shadow-sm\\\"\\n        >\\n          Request Withdrawal\\n        </button>\\n      </div>\\n\\n      <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6\\\">\\n        <div className=\\\"bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4\\\">\\n          <span className=\\\"text-xs text-slate-400 block mb-1\\\">Total Requests</span>\\n          <span className=\\\"text-2xl font-bold text-white font-mono\\\">{summary?.totalRequests || 0}</span>\\n        </div>\\n        <div className=\\\"bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4\\\">\\n          <span className=\\\"text-xs text-amber-400 block mb-1 flex items-center gap-1\\\">\\n            <Clock className=\\\"w-3 h-3\\\" /> Pending\\n          </span>\\n          <span className=\\\"text-2xl font-bold text-amber-400 font-mono\\\">{summary?.pendingRequests || 0}</span>\\n        </div>\\n        <div className=\\\"bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4\\\">\\n          <span className=\\\"text-xs text-emerald-400 block mb-1 flex items-center gap-1\\\">\\n            <CheckCircle2 className=\\\"w-3 h-3\\\" /> Approved\\n          </span>\\n          <span className=\\\"text-2xl font-bold text-emerald-400 font-mono\\\">{summary?.approvedRequests || 0}</span>\\n        </div>\\n        <div className=\\\"bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4\\\">\\n          <span className=\\\"text-xs text-rose-400 block mb-1 flex items-center gap-1\\\">\\n            <XCircle className=\\\"w-3 h-3\\\" /> Rejected\\n          </span>\\n          <span className=\\\"text-2xl font-bold text-rose-400 font-mono\\\">{summary?.rejectedRequests || 0}</span>\\n        </div>\\n      </div>\\n\\n      {/* Recent Withdrawals Table */}\\n      <div className=\\\"overflow-x-auto\\\">\\n        <table className=\\\"w-full text-left border-collapse\\\">\\n          <thead>\\n            <tr className=\\\"border-b border-slate-800 text-xs font-semibold text-slate-400\\\">\\n              <th className=\\\"pb-3 px-3\\\">Asset</th>\\n              <th className=\\\"pb-3 px-3\\\">Amount</th>\\n              <th className=\\\"pb-3 px-3\\\">Destination</th>\\n              <th className=\\\"pb-3 px-3\\\">Status</th>\\n              <th className=\\\"pb-3 px-3\\\">Date</th>\\n            </tr>\\n          </thead>\\n          <tbody className=\\\"divide-y divide-slate-800/60 text-xs font-mono\\\">\\n            {summary?.withdrawals && summary.withdrawals.length > 0 ? (\\n              summary.withdrawals.map((w: any) => (\\n                <tr key={w._id} className=\\\"hover:bg-slate-800/30 transition-colors\\\">\\n                  <td className=\\\"py-3 px-3 font-semibold text-white\\\">{w.assetType}</td>\\n                  <td className=\\\"py-3 px-3 text-amber-400\\\">-{formatNumber(w.amount)}</td>\\n                  <td className=\\\"py-3 px-3 text-slate-300 truncate max-w-[120px]\\\">{w.payoutDetails}</td>\\n                  <td className=\\\"py-3 px-3\\\">\\n                    <span className={`px-2 py-0.5 rounded-full text-[10px] font-sans font-medium uppercase ${\\n                      w.status === \'approved\' ? \'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\' :\\n                      w.status === \'pending\' ? \'bg-amber-500/10 text-amber-400 border border-amber-500/20\' :\\n                      \'bg-rose-500/10 text-rose-400 border border-rose-500/20\'\\n                    }`}>\\n                      {w.status}\\n                    </span>\\n                  </td>\\n                  <td className=\\\"py-3 px-3 text-slate-400\\\">{new Date(w.createdAt).toLocaleDateString()}</td>\\n                </tr>\\n              ))\\n            ) : (\\n              <tr>\\n                <td colSpan={5} className=\\\"py-6 text-center text-slate-500 font-sans\\\">\\n                  No withdrawal requests found.\\n                </td>\\n              </tr>\\n            )}\\n          </tbody>\\n        </table>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Create WithdrawalOverview component for user profile.\",\"Overwrite\":true,\"TargetFile\":\"/src/components/WithdrawalOverview/WithdrawalOverview.tsx\",\"toolAction\":\"Creating WithdrawalOverview component\",\"toolSummary\":\"Withdrawal overview component\"}"
