>Level {levelData?.currentLevel || 4}</span>\n          <span>Progress: {levelData?.progressPercent || 75}%</span>\n          <span>Level {(levelData?.currentLevel || 4) + 1} ({levelData?.nextLevelName || \'Elite Vanguard\'})</span>\n        </div>\n        <div className=\"w-full bg-[#0F172A] rounded-full h-3 p-0.5 border border-slate-700/60\">\n          <div\n            className=\"bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-300 h-2 rounded-full transition-all duration-500\"\n            style={{ width: `${levelData?.progressPercent || 75}%` }}\n          ></div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
