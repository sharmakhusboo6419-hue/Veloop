      thinking_signature: "\022\353\n\n\350\n\001i\024}\023\237;\225\022\342V\203\262\006*\247\215\003\035\026\310A\347\037b\355\030\016\023\n\257\005\265&\355\017\035\303\025y\b\275\253UzAv\035\307nV\033l\314\2406\001\232\2753\243\177\025A(\312K\205\321|\020\247L\001\330a\274\251$\275\271Y1e\350\231\342\355\313 \377Z\240M\300\363i\b.\241\327\267\340]\255(\337\251\363.\3476\365#\232#z{f\210\375\326\336\353\367\213{Yp\a\032\221g\364\247\206V\220C\2317\016\034\236\203j\344\253M\r\020\035\302kDtOV\315\3662\234\203\315j\204\334\333\020\357\365\214\022\267\317\225\005\332\216\324 \263\364Y\301%\357\271\371\331\375QE\'\347\375?\304\314\224\r\237z<\327\203 $l\252t\306\321\350\374\351\026\333ph\034of\034\016\005|<\251\025H\221\374\216N\033\255\3749\0043+\372\332q\246<\035nx\213y\025\235\241D;\270\"ua\255\002\230f\257\310.0\271\022\a\216\005-\341Q39?\a \321,\215\353I\270\204\302\320-|k8\356J\316`\223V\356\332\360\317\247\241\255\216\364\267\315\326\301\213\216~na\227\030\220\205\261Ui\235\322m\021i&\215\206s\351\317\352\001\nN\235\335\253\034\3507\005\350\377\254=\334d\265\033\f\004\210\034\352\361$\360\344#\2729\374\341\304]\344\223\255\234t\024.\354\000\265\303\340m\223\207;\325\037\\\206\211\250\361\230m\355C\220\370[G\201\321\\?\277Rr{\366\325:\2365-\312\237\374\363\322\360E\326\351\217\336l\0260\361\a;U\023\364\216J!\223!Ao\333\2707\322\262v\003`m\221\206\217\211zg\277z\032\266\re\217\266U\250xY\200\232\241hK\v\245\310\351,7Z\213\347\213\327(\230\347{+*s\'M\315\016\244\au\203\234\n.rI?+\273\026\336\363\355=OX\341Y\037\227]\373C\f\317{N:1\360#N\" \326\355\351\246b\340A\337d\247\256\2465/1\200\3443\206\033!\333<U\247,\375:\236\303c\0357\034\307\271\003\267b\206\022\355k8\265V\252\026\361\234\375\320\350\350\352\232\261\346\016\202\032\243@\256B\266\246> \vVO\234Ygp\264 r\304|p\364:\201\370\275\364\250\032d\277\220.]7\373\257\251\300\303sm\300\201\360JQ\320S0\245\370\vh\247\331Kq\313\347\037\036\n\305/\335p\352\206^\025\240o\254\\)i\3145\220\340]=\024\220\275\024\017\303\005\"\232\244_\377\263\320\212\346\370\027f\'\236\351\253\204p\fVI\372P&\301\270\006\035\236\206\200\245~\024z\371{\302\375\030q\272\347\324H\301<\212\355\3562\307\ai\337\'\030\342\276\203\300\253\321\037:={\022t\252\216\364\350)A0\366*ip\325\021\270\277\376\303\236:}R\277L\371c\023,r\177\344.+\320qt^\341E\233\301\027\311\226P\033\341[\257\332\'\003\333\233zB\000|\t\336\211\231A\346\271m@\030!\335%\363\2745V`P\271\201\327\365\310\005\364\024g\335vY`\031\233\366\211\320\300\224Rh\332\352F^q\337\232\253_T@\315\227\230\033`*x\037\210\265\315p1:\033\365\374\307gntQ\332\027\226N\255\252p\202\263\261\321B\373\322\247\204\317}\227\321\262\276\346BS\241\343<+iQ\235\332o\323\327\000\205\202\262\222\1772\343\'>\002M0\025Y\251\2459\340\312\330D\\\230\235\005A\003R\361H:\027\346\027\342.n&f\021\276TvAvP\242i\325\246u\306\327\333\276\247\2415\016SJ\277\372A\213I\n_O\337\253\024\331\277\350\300\334\200~\2614/\275~.\364\230p\361\2651Sy7U\232\315\030\241\230\200o\244>[\352\367\3174\323\350\215b\fG\274O\006<\234\001\273\303\002\372}\035\224k\201\322\367\257W\243V\253)wHvD\f\300\035\n\357\031ZK\0160X\253\246\321\f\021\216\002\211M\312\364>\021\001q,\020,[\214\211$\250\244\252\322L\255\367\366\351\343\f\326eW\233>\002\217Rx\331*~\262jXdr\250\303\rU\032\331\342a\342V\036(\005\3461\177\247\364\275#\365\f%\0344\360\210\320\220\2570Zy\242O@\272-\346\244\353\233tP\371\020\002\310e\270\317Z\374\257\aPR\t\004\237\217\312\300\337\233\226\352\316\316>\355zR\326;~U\261zW%\\\324\223D\370V\204&q\364.\023\360\326\335\006X\027C\275\252\214\247\206\232\307\311\a\373\b\231q\250\341\317\r\\f\020\273\266p$\221r\276=\aT\'yJ8U\023\001\354\334\366\266E\fex\231M\207\256\266\371\343\225\270\224\024X\225\255\334\335]\314\002\3136\251?v\225I\233\340B\027\326\255m\317\277(\262\307\345\b\343\346\020\366:X\005N\0361\240\204\016\264\316D\305\256$\031\264\234r50bY\200Ro\254l/M@\034\022\323yJ\244\236\215\276\177N\371\020\263\360B\\?\306\024\277\235\217$\266X7\202\371\352R\233\212\332\f\263&\033"
