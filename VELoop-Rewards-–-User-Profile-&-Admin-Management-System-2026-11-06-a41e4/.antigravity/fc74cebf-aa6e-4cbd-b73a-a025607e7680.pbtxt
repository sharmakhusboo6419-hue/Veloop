    end_line: 105
    content: "import React from \'react\';\nimport { Coins, Sparkles, Gem, Award, ArrowUpRight } from \'lucide-react\';\nimport { formatNumber } from \'../../utils/helpers\';\n\ninterface RewardAssetsProps {\n  wallet: {\n    veBalance: number;\n    sveBalance: number;\n    gemsBalance: number;\n    tokensBalance: number;\n    xpBalance: number;\n  };\n  onActionClick: (action: string) => void;\n}\n\nexport const RewardAssets: React.FC<RewardAssetsProps> = ({ wallet, onActionClick }) => {\n  const assets = [\n    {\n      name: \'VEs (VELoop Earnings)\',\n      balance: wallet.veBalance,\n      symbol: \'VE\',\n      description: \'Primary platform reward currency convertible to payouts.\',\n      icon: <Coins className=\"w-6 h-6 text-amber-400\" />,\n      colorClass: \'from-amber-500/20 to-yellow-500/5 border-amber-500/30 text-amber-400\',\n      badgeBg: \'bg-amber-500/10 text-amber-400 border-amber-500/20\'\n    },\n    {\n      name: \'SVEs (Silver Vault Earnings)\',\n      balance: wallet.sveBalance,\n      symbol: \'SVE\',\n      description: \'Secured vault earnings accrued from high-tier activities.\',\n      icon: <Sparkles className=\"w-6 h-6 text-slate-300\" />,\n      colorClass: \'from-slate-400/20 to-slate-600/5 border-slate-500/30 text-slate-200\',\n      badgeBg: \'bg-slate-400/10 text-slate-300 border-slate-500/20\'\n    },\n    {\n      name: \'Gems\',\n      balance: wallet.gemsBalance,\n      symbol: \'GEMS\',\n      description: \'Rare utility gems used for boosts and exclusive redemptions.\',\n      icon: <Gem className=\"w-6 h-6 text-cyan-400\" />,\n      colorClass: \'from-cyan-500/20 to-blue-500/5 border-cyan-500/30 text-cyan-400\',\n      badgeBg: \'bg-cyan-500/10 text-cyan-400 border-cyan-500/20\'\n    },\n    {\n      name: \'Platform Tokens\',\n      balance: wallet.tokensBalance,\n      symbol: \'TOKENS\',\n      description: \'Governance and ecosystem liquidity tokens.\',\n      icon: <Coins className=\"w-6 h-6 text-emerald-400\" />,\n      colorClass: \'from-emerald-500/20 to-teal-500/5 border-emerald-500/30 text-emerald-400\',\n      badgeBg: \'bg-emerald-500/10 text-emerald-400 border-emerald-500/20\'\n    },\n    {\n      name: \'Experience Points (XP)\',\n      balance: wallet.xpBalance,\n      symbol: \'XP\',\n      description: \'Progression metric for account level advancement.\',\n      icon: <Award className=\"w-6 h-6 text-indigo-400\" />,\n      colorClass: \'from-indigo-500/20 to-purple-500/5 border-indigo-500/30 text-indigo-400\',\n      badgeBg: \'bg-indigo-500/10 text-indigo-400 border-indigo-500/20\'\n    }\n  ];\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"flex items-center justify-between\">\n        <h2 className=\"text-xl font-bold text-white tracking-tight\">Your Reward Assets</h2>\n        <button\n          onClick={() => onActionClick(\'withdraw\')}\n          className=\"text-xs font-semibold text-blue-400 hover:text-blue-300 flex items-center gap-1 transition-colors\"\n        >\n          Withdraw Assets <ArrowUpRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {assets.map((asset, idx) => (\n          <div\n            key={idx}\n            className={`bg-[#1E293B] border rounded-xl p-5 shadow-md bg-gradient-to-br ${asset.colorClass} flex flex-col justify-between`}\n          >\n            <div>\n              <div className=\"flex items-center justify-between mb-3\">\n                <div className=\"p-2.5 rounded-lg bg-[#0F172A]/60 border border-slate-700/50\">\n                  {asset.icon}\n                </div>\n                <span className={`text-xs font-mono font-bold px-2.5 py-1 rounded-full border ${asset.badgeBg}`}>\n                  {asset.symbol}\n                </span>\n              </div>\n              <h3 className=\"text-sm font-medium text-slate-300 mb-1\">{asset.name}</h3>\n              <div className=\"text-3xl font-extrabold text-white font-mono tracking-tight mb-2\">\n                {formatNumber(asset.balance)}\n              </div>\n            </div>\n            <p className=\"text-xs text-slate-400 pt-3 border-t border-slate-700/50\">\n              {asset.description}\n            </p>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 106
    num_bytes: 4156
    line_range_bytes: 4156
  }
}
