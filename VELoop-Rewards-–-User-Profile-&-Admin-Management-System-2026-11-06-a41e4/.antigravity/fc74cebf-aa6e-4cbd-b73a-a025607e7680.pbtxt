      create_file {
        instruction: "import React from \'react\';\nimport { Link, useNavigate, useLocation } from \'react-router-dom\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { LogOut, Lock } from \'lucide-react\';\nimport styles from \'./Navbar.module.css\';\n\nexport const Navbar: React.FC = () => {\n  const { user, token, isAdmin, adminUser, logout, adminLogout } = useAuth();\n  const navigate = useNavigate();\n  const location = useLocation();\n\n  const handleLogout = () => {\n    logout();\n    navigate(\'/login\');\n  };\n\n  const handleAdminLogout = () => {\n    adminLogout();\n    navigate(\'/admin/login\');\n  };\n\n  const isAdminRoute = location.pathname.startsWith(\'/admin\');\n\n  return (\n    <nav className={`navbar navbar-expand-lg navbar-dark sticky-top ${styles.navbarCustom}`}>\n      <div className=\"container-fluid\">\n        <Link to={isAdminRoute ? \'/admin/dashboard\' : \'/user-profile\'} className=\"navbar-brand d-flex align-items-center gap-2 text-decoration-none\">\n          <div className={styles.brandLogo}>\n            VE\n          </div>\n          <div>\n            <span className=\"fw-bold text-white d-block\">VELoop Rewards</span>\n            <span className=\"small text-warning font-monospace d-block\" style={{ fontSize: \'10px\' }}>{isAdminRoute ? \'Admin Console\' : \'Member Portal\'}</span>\n          </div>\n        </Link>\n\n        <div className=\"d-flex align-items-center gap-3\">\n          {!isAdminRoute ? (\n            token && user ? (\n              <div className=\"d-flex align-items-center gap-3\">\n                <div className=\"text-end d-none d-sm-block\">\n                  <span className=\"small fw-semibold text-white d-block\">{user.username}</span>\n                  <span className=\"text-muted font-monospace\" style={{ fontSize: \'10px\' }}>Code: {user.referralCode}</span>\n                </div>\n                <button\n                  onClick={handleLogout}\n                  className=\"btn btn-secondary btn-sm d-flex align-items-center gap-1\"\n                >\n                  <LogOut size={14} /> Logout\n                </button>\n              </div>\n            ) : (\n              <div className=\"d-flex align-items-center gap-2\">\n                <Link to=\"/login\" className=\"btn btn-primary btn-sm\">\n                  Sign In\n                </Link>\n                <Link to=\"/admin/login\" className=\"btn btn-secondary btn-sm d-flex align-items-center gap-1\">\n                  <Lock size={12} /> Admin\n                </Link>\n              </div>\n            )\n          ) : (\n            isAdmin && adminUser ? (\n              <div className=\"d-flex align-items-center gap-3\">\n                <div className=\"text-end d-none d-sm-block\">\n                  <span className=\"small fw-semibold text-white d-block\">{adminUser.username}</span>\n                  <span className=\"text-warning font-monospace\" style={{ fontSize: \'10px\' }}>Role: {adminUser.role}</span>\n                </div>\n                <button\n                  onClick={handleAdminLogout}\n                  className=\"btn btn-secondary btn-sm d-flex align-items-center gap-1\"\n                >\n                  <LogOut size={14} /> Logout\n                </button>\n              </div>\n            ) : (\n              <Link to=\"/admin/login\" className=\"btn btn-warning btn-sm text-dark fw-semibold\">\n                Admin Sign In\n              </Link>\n            )\n          )}\n        </div>\n      </div>\n    </nav>\n  );\n};\n"
        path {
