      create_file {
        instruction: "import React from \'react\';\nimport { Users, Copy, Award, Sparkles } from \'lucide-react\';\nimport { copyToClipboard, formatNumber } from \'../../utils/helpers\';\n\ninterface ReferralSnapshotProps {\n  referrals: any;\n  onCopyToast: (msg: string) => void;\n}\n\nexport const ReferralSnapshot: React.FC<ReferralSnapshotProps> = ({ referrals, onCopyToast }) => {\n  const referralLink = `${window.location.origin}/login?ref=${referrals?.referralCode || \'ALEX2026\'}`;\n\n  return (\n    <div className=\"bg-[#1E293B] border border-slate-800 rounded-2xl p-6 shadow-md\">\n      <div className=\"flex items-center justify-between mb-4\">\n        <h2 className=\"text-xl font-bold text-white tracking-tight flex items-center gap-2\">\n          <Users className=\"w-5 h-5 text-emerald-400\" /> Referral Snapshot\n        </h2>\n        <span className=\"text-xs font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full\">\n          Code: {referrals?.referralCode || \'ALEX2026\'}\n        </span>\n      </div>\n\n      <div className=\"bg-[#0F172A]/80 border border-slate-800 rounded-xl p-4 mb-6 flex flex-col sm:flex-row items-center justify-between gap-4\">\n        <div>\n          <span className=\"text-xs text-slate-400 block mb-1\">Your Referral Link</span>\n          <span className=\"text-sm font-mono text-emerald-400 select-all\">{referralLink}</span>\n        </div>\n        <button\n          onClick={() => {\n            copyToClipboard(referralLink);\n            onCopyToast(\'Referral link copied to clipboard!\');\n          }}\n          className=\"px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition-colors whitespace-nowrap\"\n        >\n          <Copy className=\"w-4 h-4\" /> Copy Link\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n        <div className=\"bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4\">\n          <span className=\"text-xs text-slate-400 block mb-1\">Total Referrals</span>\n          <span className=\"text-2xl font-bold text-white font-mono\">{referrals?.totalReferrals || 0}</span>\n        </div>\n        <div className=\"bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4\">\n          <span className=\"text-xs text-slate-400 block mb-1\">Rewards Earned</span>\n          <span className=\"text-2xl font-bold text-amber-400 font-mono\">{formatNumber(referrals?.totalRewardsEarned)} VEs</span>\n        </div>\n        <div className=\"bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4\">\n          <span className=\"text-xs text-slate-400 block mb-1\">XP Earned</span>\n          <span className=\"text-2xl font-bold text-indigo-400 font-mono\">+{formatNumber(referrals?.totalXpEarned)} XP</span>\n        </div>\n      </div>\n\n      {/* Referrals list */}\n      <div className=\"space-y-2\">\n        <h3 className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2\">Referred Members</h3>\n        {referrals?.referralsList && referrals.referralsList.length > 0 ? (\n          referrals.referralsList.map((ref: any) => (\n            <div key={ref._id} className=\"bg-[#0F172A]/50 border border-slate-800 rounded-xl p-3 flex items-center justify-between text-xs\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold\">\n                  {ref.referredUserId?.username?.[0] || \'U\'}\n                </div>\n                <div>\n                  <span className=\"font-semibold text-white block\">{ref.referredUserId?.username || \'Member\'}</span>\n                  <span className=\"text-slate-400\">{ref.referredUserId?.email || \'user@veloop.io\'}</span>\n                </div>\n              </div>\n              <div className=\"text-right font-mono\">\n                <span className=\"text-emerald-400 block font-semibold\">+{ref.rewardEarned} VEs</span>\n                <span className=\"text-slate-500\">{new Date(ref.createdAt).toLocaleDateString()}</span>\n              </div>\n            </div>\n          ))\n        ) : (\n          <div className=\"text-center py-6 text-slate-500 text-xs\">\n            No referrals yet. Share your link to start earning rewards!\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ReferralSnapshot/ReferralSnapshot.tsx"
        }
        overwrite: true
      }
    }
