  code_action {
    action_spec {
      create_file {
        instruction: "import React, { createContext, useContext, useState, useEffect } from \'react\';\n\ninterface User {\n  id: string;\n  username: string;\n  email: string;\n  referralCode: string;\n  status: string;\n  createdAt?: string;\n}\n\ninterface AuthContextType {\n  user: User | null;\n  token: string | null;\n  isAdmin: boolean;\n  adminUser: any | null;\n  adminToken: string | null;\n  login: (token: string, userData: User) => void;\n  adminLogin: (token: string, adminData: any) => void;\n  logout: () => void;\n  adminLogout: () => void;\n  loading: boolean;\n}\n\nconst AuthContext = createContext<AuthContextType | undefined>(undefined);\n\nexport const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [user, setUser] = useState<User | null>(null);\n  const [token, setToken] = useState<string | null>(localStorage.getItem(\'veloop_token\'));\n  const [adminUser, setAdminUser] = useState<any | null>(null);\n  const [adminToken, setAdminToken] = useState<string | null>(localStorage.getItem(\'veloop_admin_token\'));\n  const [isAdmin, setIsAdmin] = useState<boolean>(!!localStorage.getItem(\'veloop_admin_token\'));\n  const [loading, setLoading] = useState<boolean>(true);\n\n  useEffect(() => {\n    async function verifySession() {\n      if (token) {\n        try {\n          const res = await fetch(\'/api/auth/me\', {\n            headers: { Authorization: `Bearer ${token}` }\n          });\n          if (res.ok) {\n            const data = await res.json();\n            setUser(data.user);\n          } else {\n            localStorage.removeItem(\'veloop_token\');\n            setToken(null);\n          }\n        } catch (e) {\n          console.error(\'Session verify error\', e);\n        }\n      }\n      setLoading(false);\n    }\n    verifySession();\n  }, [token]);\n\n  const login = (newToken: string, userData: User) => {\n    localStorage.setItem(\'veloop_token\', newToken);\n    setToken(newToken);\n    setUser(userData);\n  };\n\n  const adminLogin = (newToken: string, adminData: any) => {\n    localStorage.setItem(\'veloop_admin_token\', newToken);\n    setAdminToken(newToken);\n    setAdminUser(adminData);\n    setIsAdmin(true);\n  };\n\n  const logout = () => {\n    localStorage.removeItem(\'veloop_token\');\n    setToken(null);\n    setUser(null);\n  };\n\n  const adminLogout = () => {\n    localStorage.removeItem(\'veloop_admin_token\');\n    setAdminToken(null);\n    setAdminUser(null);\n    setIsAdmin(false);\n  };\n\n  return (\n    <AuthContext.Provider value={{ user, token, isAdmin, adminUser, adminToken, login, adminLogin, logout, adminLogout, loading }}>\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nexport const useAuth = () => {\n  const context = useContext(AuthContext);\n  if (!context) {\n    throw new Error(\'useAuth must be used within an AuthProvider\');\n  }\n  return context;\n};\n"
        path {
          absolute_uri: "file:///src/context/AuthContext.tsx"
        }
        overwrite: true
      }
    }
