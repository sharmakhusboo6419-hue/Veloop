              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Installation & Local Setup"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Clone the repository**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```bash"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   git clone https://github.com/your-username/veloop-rewards.git"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   cd veloop-rewards"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Install dependencies**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```bash"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   npm install"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Configure Environment Variables**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   Copy the example environment template:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```bash"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   cp .env.example .env"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   Fill in your configuration details:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```env"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   PORT=3000"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   MONGO_URI=\"mongodb+srv://<username>:<password>@cluster.mongodb.net/veloop_rewards?retryWrites=true&w=majority\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   JWT_SECRET=\"veloop_super_secret_jwt_key_2026\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ADMIN_EMAIL=\"admin@veloop.io\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ADMIN_PASSWORD=\"Admin@123\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   NODE_ENV=\"development\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Start the Application**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```bash"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   npm run dev"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   The unified server will start on `http://localhost:3000`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Standalone Backend Mode** (Optional):"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```bash"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   cd backend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   npm install"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   npm run dev"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   ```"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
