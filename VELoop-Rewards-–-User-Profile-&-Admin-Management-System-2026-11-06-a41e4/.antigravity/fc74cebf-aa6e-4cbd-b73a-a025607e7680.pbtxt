            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Database Schema Design (MongoDB & Mongoose)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **User**: `username`, `email`, `passwordHash`, `referralCode`, `referredBy`, `status` (active/suspended), `emailVerified`, `createdAt`, `updatedAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Wallet**: `userId`, `veBalance`, `sveBalance`, `gemsBalance`, `tokensBalance`, `xpBalance`, `currentLevel`, `updatedAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **WalletTransaction**: `userId`, `assetType` (VE, SVE, Gems, Tokens, XP), `amount`, `type` (earn, spend, adjust, withdrawal), `referenceId`, `description`, `createdAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **UserLevel**: `levelNumber`, `levelName`, `xpThreshold`, `badgeUrl`, `isActive`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Achievement**: `title`, `description`, `badgeUrl`, `xpReward`, `criteriaType`, `criteriaValue`, `isActive`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **UserAchievement**: `userId`, `achievementId`, `unlockedAt`, `progress`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "7. **Referral**: `referrerId`, `referredUserId`, `status` (pending, successful), `rewardEarned`, `xpEarned`, `createdAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "8. **Withdrawal**: `userId`, `assetType`, `amount`, `status` (pending, approved, rejected, failed), `payoutDetails`, `rejectionReason`, `processedBy`, `createdAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "9. **ActivityLog**: `userId`, `actionType`, `description`, `metadata`, `createdAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "10. **AdminUser**: `username`, `email`, `passwordHash`, `role` (super_admin, moderator), `lastLogin`, `createdAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "11. **AdminAuditLog**: `adminId`, `action`, `targetModel`, `targetId`, `changesSummary`, `ipAddress`, `createdAt`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 4. API Endpoint List"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Authentication"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `POST /api/auth/register` - Register a new user"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `POST /api/auth/login` - User login"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `POST /api/auth/logout` - User logout"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/auth/me` - Get current authenticated user session"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### User Profile"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/profile/me` - Get user profile details"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `PATCH /api/profile/me` - Update permitted profile details"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/profile/rewards` - Get wallet balances for VEs, SVEs, Gems, Tokens, XP"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/profile/level-progress` - Get current level, XP, and progress toward next level"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/profile/achievements` - Get unlocked and upcoming achievements"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/profile/withdrawal-summary` - Get withdrawal request stats and history"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/profile/referrals` - Get referral snapshot and statistics"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/profile/activity` - Get recent user activity feed"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "### Admin Management"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `POST /api/admin/auth/login` - Admin login (with seeded demo credentials)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/admin/stats` - Platform overview statistics"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/admin/users` - Paginated user list with search/filter"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/admin/users/:id` - Detailed user view (wallet, activity, referrals)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `PATCH /api/admin/users/:id/status` - Suspend or restore user account"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `POST /api/admin/rewards/adjust` - Adjust user wallet balances (with audit trail)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/admin/withdrawals` - List withdrawal requests with status filter"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `PATCH /api/admin/withdrawals/:id/status` - Approve or reject withdrawal request"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- `GET /api/admin/audit-logs` - System administration audit log trail"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 5. UI/UX Design Plan"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Theme & Palette**: Deep navy background (`#161827`), cool slate structural cards (`#1E293B`), gold & warm yellow accent (`#F59E0B`), soft blue (`#3B82F6`), and silver highlights."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Design Rules**: Zero pill badges for static metadata, clean typographic separators (`\302\267`), strict tabular numerals (`tabular-nums`) for financial balances and XP, single-elevation depth, mobile-first responsiveness (320px to 1920px)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Interactive Feedback**: Loading skeletons, empty states with clear calls to action, toast notifications for copy actions and form submissions."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 6. Development Milestones"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Milestone 1**: Project configuration, database setup, and Mongoose models."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Milestone 2**: Backend REST API controllers, authentication middleware, and seed script (including demo admin)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Milestone 3**: React frontend routing, authentication context, and User Profile Dashboard components."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Milestone 4**: Protected Admin Panel dashboard, user management, reward adjustment, and withdrawal processing."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Milestone 5**: Security hardening, testing, and documentation (`README.md`, `API_DOCUMENTATION.md`, `DEMO_ACCESS.md`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///.aistudio/artifacts/brain/fc74cebf-aa6e-4cbd-b73a-a025607e7680/implementation_plan.md"
        create_file: true
      }
    }
