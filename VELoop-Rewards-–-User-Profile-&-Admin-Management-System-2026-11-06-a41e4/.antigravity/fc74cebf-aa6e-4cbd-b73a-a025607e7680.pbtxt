      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Coins, Gem, Sparkles, Users, Award, ShieldCheck, ArrowRight } from \'lucide-react\';\\n\\ninterface QuickActionsProps {\\n  onActionClick: (action: string) => void;\\n}\\n\\nexport const QuickActions: React.FC<QuickActionsProps> = ({ onActionClick }) => {\\n  const actions = [\\n    {\\n      title: \'Earn More VEs\',\\n      description: \'Complete daily tasks and challenges\',\\n      icon: <Coins className=\\\"w-5 h-5 text-amber-400\\\" />,\\n      actionKey: \'earn_ve\',\\n      color: \'hover:border-amber-500/50 hover:bg-amber-500/5\'\\n    },\\n    {\\n      title: \'Get More Gems\',\\n      description: \'Unlock rare vault bonuses\',\\n      icon: <Gem className=\\\"w-5 h-5 text-cyan-400\\\" />,\\n      actionKey: \'get_gems\',\\n      color: \'hover:border-cyan-500/50 hover:bg-cyan-500/5\'\\n    },\\n    {\\n      title: \'Refer Friends\',\\n      description: \'Invite members and earn 50 VEs\',\\n      icon: <Users className=\\\"w-5 h-5 text-emerald-400\\\" />,\\n      actionKey: \'refer\',\\n      color: \'hover:border-emerald-500/50 hover:bg-emerald-500/5\'\\n    },\\n    {\\n      title: \'Request Withdrawal\',\\n      description: \'Convert VEs to external wallet\',\\n      icon: <Sparkles className=\\\"w-5 h-5 text-blue-400\\\" />,\\n      actionKey: \'withdraw\',\\n      color: \'hover:border-blue-500/50 hover:bg-blue-500/5\'\\n    }\\n  ];\\n\\n  return (\\n    <div className=\\\"bg-[#1E293B] border border-slate-800 rounded-2xl p-6 shadow-md\\\">\\n      <h2 className=\\\"text-xl font-bold text-white tracking-tight mb-4 flex items-center gap-2\\\">\\n        <Award className=\\\"w-5 h-5 text-amber-400\\\" /> Quick Actions\\n      </h2>\\n\\n      <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n        {actions.map((act, idx) => (\\n          <button\\n            key={idx}\\n            onClick={() => onActionClick(act.actionKey)}\\n            className={`bg-[#0F172A]/70 border border-slate-800 rounded-xl p-4 text-left transition-all ${act.color} group flex flex-col justify-between`}\\n          >\\n            <div>\\n              <div className=\\\"p-2.5 rounded-lg bg-[#1E293B] border border-slate-700/60 w-fit mb-3\\\">\\n                {act.icon}\\n              </div>\\n              <h3 className=\\\"text-sm font-bold text-white mb-1 group-hover:text-amber-400 transition-colors flex items-center justify-between\\\">\\n                {act.title}\\n                <ArrowRight className=\\\"w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity text-amber-400\\\" />\\n              </h3>\\n              <p className=\\\"text-xs text-slate-400\\\">{act.description}</p>\\n            </div>\\n          </button>\\n        ))}\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Create QuickActions component for user profile.\",\"Overwrite\":true,\"TargetFile\":\"/src/components/QuickActions/QuickActions.tsx\",\"toolAction\":\"Creating QuickActions component\",\"toolSummary\":\"Quick actions component\"}"
