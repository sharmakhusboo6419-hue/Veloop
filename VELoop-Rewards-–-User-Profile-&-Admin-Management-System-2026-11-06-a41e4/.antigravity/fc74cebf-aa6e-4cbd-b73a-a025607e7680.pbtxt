  planner_response {
    thinking: "**Implementing Withdrawal Requests**\n\nI\'m currently working on incorporating the `requestWithdrawal` functionality within `backend/src/controllers/profileController.js`. I\'ve started by defining the async function, and now I\'m thinking about the parameters required: asset type, amount, and payout information. I need to make sure the implementation aligns with our security protocols and user experience.\n\n\n**Validating Withdrawal Parameters**\n\nI\'ve added input validation to `requestWithdrawal`. I\'m now verifying the request body contains `assetType`, a positive `amount`, and `payoutDetails`. I\'m rejecting invalid `assetType`s (no XP withdrawals!), and checking for insufficient balances against the user\'s wallet. I\'m also converting the provided amount to a number. I\'m ensuring it\'s not negative or zero.\n\n\n"
    tool_calls {
      id: "call_5826331261802181864"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Add requestWithdrawal function to backend profileController.js\",\"EndLine\":155,\"Instruction\":\"Add requestWithdrawal controller function\",\"ReplacementContent\":\"      withdrawals\\n    });\\n  } catch (error) {\\n    next(error);\\n  }\\n};\\n\\n/**\\n * Request a new withdrawal\\n */\\nexport const requestWithdrawal = async (req, res, next) => {\\n  try {\\n    const { assetType, amount, payoutDetails } = req.body;\\n    const numAmount = Number(amount);\\n\\n    if (!assetType || !numAmount || numAmount <= 0 || !payoutDetails) {\\n      return res.status(400).json({ success: false, error: \'Please provide valid assetType, positive amount, and payout destination.\' });\\n    }\\n\\n    if (![\'VE\', \'SVE\', \'Gems\', \'Tokens\'].includes(assetType)) {\\n      return res.status(400).json({ success: false, error: \'Invalid asset type for withdrawal. XP cannot be withdrawn.\' });\\n    }\\n\\n    const wallet = await Wallet.findOne({ userId: req.user.id });\\n    if (!wallet) {\\n      return res.status(404).json({ success: false, error: \'Wallet not found.\' });\\n    }\\n\\n    const key = `${assetType.toLowerCase()}Balance`;\\n    const curBal = Number(wallet[key]) || 0;\\n    if (curBal < numAmount) {\\n      return res.status(400).json({ success: false, error: `Insufficient ${assetType} balance. You have ${curBal} ${assetType}.` });\\n    }\\n\\n    wallet[key] = curBal - numAmount;\\n    await wallet.save();\\n\\n    const withdrawal = await Withdrawal.create({\\n      userId: req.user.id,\\n      assetType,\\n      amount: numAmount,\\n      status: \'pending\',\\n      payoutDetails\\n    });\\n\\n    await WalletTransaction.create({\\n      userId: req.user.id,\\n      assetType,\\n      amount: -numAmount,\\n      type: \'withdrawal\',\\n      description: `Withdrawal request of ${numAmount} ${assetType} to ${payoutDetails}`\\n    });\\n\\n    await ActivityLog.create({\\n      userId: req.user.id,\\n      actionType: \'WITHDRAWAL_REQUEST\',\\n      description: `Requested withdrawal of ${numAmount} ${assetType}`,\\n      metadata: { amount: numAmount, assetType, withdrawalId: withdrawal._id }\\n    });\\n\\n    res.status(201).json({ success: true, message: \'Withdrawal request submitted successfully\', withdrawal });\\n  } catch (error) {\\n    next(error);\\n  }\\n};\",\"StartLine\":150,\"TargetContent\":\"      withdrawals\\n    });\\n  } catch (error) {\\n    next(error);\\n  }\\n};\",\"TargetFile\":\"/backend/src/controllers/profileController.js\",\"toolAction\":\"Adding requestWithdrawal to profileController\",\"toolSummary\":\"Add requestWithdrawal\"}"
