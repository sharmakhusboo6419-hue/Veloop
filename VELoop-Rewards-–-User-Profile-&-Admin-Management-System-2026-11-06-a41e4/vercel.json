{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/index.html"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/user-profile",
      "destination": "/index.html"
    }
  ]
}
